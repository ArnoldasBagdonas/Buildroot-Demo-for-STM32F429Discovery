# Common size-oriented settings for normal example images. Package fragments
# are applied afterwards and re-enable the interfaces required by the selected
# example. Sysdiag uses a broader diagnostic profile.

# DRM selects the I2C core, so disable only its unused userspace interface and
# STM32F4 controller. A later package fragment may re-enable a required stack.
# CONFIG_I2C_CHARDEV is not set
# CONFIG_I2C_STM32F4 is not set
# CONFIG_SPI_SLAVE is not set
# CONFIG_SPI_SPIDEV is not set
# CONFIG_GPIO_CDEV is not set
# CONFIG_DEVMEM is not set
# CONFIG_PWM is not set
# CONFIG_MFD_STM32_TIMERS is not set
# CONFIG_RTC_CLASS is not set
# CONFIG_NVMEM is not set

# The small single-threaded applets do not use these optional descriptor and
# userspace-locking syscall families.
# CONFIG_FUTEX is not set
# CONFIG_EPOLL is not set
# CONFIG_TIMERFD is not set

# A 100 Hz tick is used unless an example requires high-resolution timers.
# CONFIG_HIGH_RES_TIMERS is not set
CONFIG_HZ_100=y
# CONFIG_HZ_1000 is not set
CONFIG_HZ=100

# Omit optional page-cache reporting, procfs sysctl, TTY injection, and debug
# facilities while retaining procfs itself for DRM fbdev registration.
# CONFIG_CACHESTAT_SYSCALL is not set
# CONFIG_PROC_SYSCTL is not set
# CONFIG_LEGACY_TIOCSTI is not set
# CONFIG_DEBUG_MEMORY_INIT is not set
# CONFIG_STACKTRACE is not set
