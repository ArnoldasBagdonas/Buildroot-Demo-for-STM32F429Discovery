From b5d83c88b8366049d1916785de38f212e1630882 Mon Sep 17 00:00:00 2001
From: Buildroot Demo <buildroot-demo@example.com>
Date: Sun, 16 Aug 2026 01:00:00 +0000
Subject: [PATCH] fbv: downsample large JPEGs during decode

The existing fit options allocate and decode the full source image before
resizing it. Multi-megapixel camera images therefore exhaust memory on small
no-MMU boards even though the displayed result is only 240x320.

Ask libjpeg for its native 1/2, 1/4, or 1/8 IDCT reduction when a JPEG is
larger than the framebuffer. This preserves aspect ratio, substantially lowers
peak memory, and leaves fbv's normal fit pass to perform the exact final resize.
---
 fbv.h  |  2 +-
 jpeg.c | 30 ++++++++++++++++++++++++------
 main.c |  5 +++--
 3 files changed, 28 insertions(+), 9 deletions(-)

--- a/fbv.h
+++ b/fbv.h
@@ -30,7 +30,7 @@
 
 int fh_jpeg_id(char *name);
 int fh_jpeg_load(char *name,unsigned char *buffer, unsigned char **alpha, int x,int y);
-int fh_jpeg_getsize(char *name,int *x,int *y);
+int fh_jpeg_getsize(char *name,int *x,int *y,int max_x,int max_y);
 
 int fh_png_id(char *name);
 int fh_png_load(char *name,unsigned char *buffer, unsigned char **alpha, int x,int y);
--- a/jpeg.c
+++ b/jpeg.c
@@ -62,7 +62,7 @@
     struct jpeg_decompress_struct *ciptr;
     struct r_jpeg_error_mgr emgr;
     unsigned char *bp;
-    int px,py,c;
+    int px,py,c,denom;
     FILE *fh;
     JSAMPLE *lb;
 
@@ -82,6 +82,16 @@
     jpeg_stdio_src(ciptr,fh);
     jpeg_read_header(ciptr,TRUE);
     ciptr->out_color_space=JCS_RGB;
+    for(denom=1;denom<=8;denom*=2)
+    {
+        ciptr->scale_num=1;
+        ciptr->scale_denom=denom;
+        jpeg_calc_output_dimensions(ciptr);
+        if(ciptr->output_width==(JDIMENSION)x &&
+           ciptr->output_height==(JDIMENSION)y)
+            break;
+    }
+    if(denom>8) ciptr->scale_denom=1;
     jpeg_start_decompress(ciptr);
 
     px=ciptr->output_width; py=ciptr->output_height;
@@ -106,12 +116,12 @@
     return(FH_ERROR_OK);
 }
 
-int fh_jpeg_getsize(char *filename,int *x,int *y)
+int fh_jpeg_getsize(char *filename,int *x,int *y,int max_x,int max_y)
 {
     struct jpeg_decompress_struct cinfo;
     struct jpeg_decompress_struct *ciptr;
     struct r_jpeg_error_mgr emgr;
-    int px,py,c;
+    int denom;
     FILE *fh;
 
     ciptr=&cinfo;
@@ -131,10 +141,18 @@
     jpeg_stdio_src(ciptr,fh);
     jpeg_read_header(ciptr,TRUE);
     ciptr->out_color_space=JCS_RGB;
-    jpeg_start_decompress(ciptr);
-    px=ciptr->output_width; py=ciptr->output_height;
-    c=ciptr->output_components;
-    *x=px; *y=py;
+    for(denom=1;denom<=8;denom*=2)
+    {
+        ciptr->scale_num=1;
+        ciptr->scale_denom=denom;
+        jpeg_calc_output_dimensions(ciptr);
+        if(max_x<=0 || max_y<=0 ||
+           (ciptr->output_width<=(JDIMENSION)max_x &&
+            ciptr->output_height<=(JDIMENSION)max_y) || denom==8)
+            break;
+    }
+    *x=ciptr->output_width;
+    *y=ciptr->output_height;
     jpeg_destroy_decompress(ciptr);
     fclose(fh);
     return(FH_ERROR_OK);
--- a/main.c
+++ b/main.c
@@ -210,6 +210,8 @@
 	
 	struct image i;
 	
+	getCurrentRes(&screen_width, &screen_height);
+
 #ifdef FBV_SUPPORT_GIF
 	if(fh_gif_id(filename))
 		if(fh_gif_getsize(filename, &x_size, &y_size) == FH_ERROR_OK)
@@ -230,7 +232,8 @@
 
 #ifdef FBV_SUPPORT_JPEG
 	if(fh_jpeg_id(filename))
-		if(fh_jpeg_getsize(filename, &x_size, &y_size) == FH_ERROR_OK)
+		if(fh_jpeg_getsize(filename, &x_size, &y_size,
+			transform_stretch ? screen_width : 0, transform_stretch ? screen_height : 0) == FH_ERROR_OK)
 		{
 			load = fh_jpeg_load;
 			goto identified;
@@ -270,7 +273,6 @@
 	
 	
 
-	getCurrentRes(&screen_width, &screen_height);
 	i.do_free = 0;
 	while(1)
 	{
-- 
