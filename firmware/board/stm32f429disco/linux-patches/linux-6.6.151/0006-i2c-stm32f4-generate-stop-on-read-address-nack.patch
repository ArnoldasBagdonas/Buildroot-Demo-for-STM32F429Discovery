From 9e0928e4278d2e8186078579601065d8c92a69cc Mon Sep 17 00:00:00 2001
From: Buildroot STM32F429 demo <noreply@example.com>
Date: Sat, 22 Aug 2026 08:13:00 +0300
Subject: [PATCH] i2c: stm32f4: generate STOP on read address NACK

An acknowledge failure while addressing a slave for a read leaves the
STM32F4 peripheral in master mode with SR2.BUSY asserted.  The existing
error path generates STOP only for writes, so every later transfer fails
with -EBUSY even though SCL and SDA are physically high.

The master cannot receive an acknowledge failure while receiving data;
for a read transfer AF therefore represents the address NACK and requires
STOP just as it does for a write transfer.

Signed-off-by: Buildroot STM32F429 demo <noreply@example.com>
---
 drivers/i2c/busses/i2c-stm32f4.c | 10 ++++------
 1 file changed, 4 insertions(+), 6 deletions(-)

diff --git a/drivers/i2c/busses/i2c-stm32f4.c b/drivers/i2c/busses/i2c-stm32f4.c
index 8e39c056f022..f798f507e410 100644
--- a/drivers/i2c/busses/i2c-stm32f4.c
+++ b/drivers/i2c/busses/i2c-stm32f4.c
@@ -642,15 +642,13 @@ static irqreturn_t stm32f4_i2c_isr_error(int irq, void *data)
 	}
 
 	/*
-	 * Acknowledge failure:
-	 * In master transmitter mode a Stop must be generated by software
+	 * Acknowledge failure. Generate STOP to release master mode. For a
+	 * read transfer AF can occur when the slave NACKs its address.
 	 */
 	if (status & STM32F4_I2C_SR1_AF) {
-		if (!(msg->addr & I2C_M_RD)) {
-			reg = i2c_dev->base + STM32F4_I2C_CR1;
-			stm32f4_i2c_set_bits(reg, STM32F4_I2C_CR1_STOP);
-		}
+		reg = i2c_dev->base + STM32F4_I2C_CR1;
+		stm32f4_i2c_set_bits(reg, STM32F4_I2C_CR1_STOP);
 		status &= ~STM32F4_I2C_SR1_AF;
 		writel_relaxed(status, i2c_dev->base + STM32F4_I2C_SR1);
 		msg->result = -EIO;
 	}
-- 
