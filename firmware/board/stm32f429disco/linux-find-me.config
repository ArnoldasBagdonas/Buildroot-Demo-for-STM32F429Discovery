CONFIG_HIGH_RES_TIMERS=y
CONFIG_POSIX_TIMERS=y
CONFIG_TIMERFD=y
# The external uClibc toolchain calls the legacy time32 timerfd syscalls.
CONFIG_COMPAT_32BIT_TIME=y
CONFIG_NVMEM=y
CONFIG_NVMEM_SYSFS=y
CONFIG_NVMEM_STM32_ROMEM=y
CONFIG_PROC_FS=y
# Find Me reads the on-board PA0 USER button and drives the PG13 status LED
# through the GPIO v2 character-device API.
CONFIG_GPIO_CDEV=y
