# USB USER port, DWC2 peripheral controller, and CDC ACM serial gadget.
CONFIG_PRINTK=y
CONFIG_USB_SUPPORT=y
CONFIG_USB_GADGET=y
CONFIG_USB_DWC2=y
CONFIG_USB_DWC2_PERIPHERAL=y
CONFIG_USB_G_SERIAL=y
# CONFIG_U_SERIAL_CONSOLE is not set

# Keep the existing USART1 kernel console. ttyGS0 is an independent data port.
CONFIG_SERIAL_STM32_CONSOLE=y
