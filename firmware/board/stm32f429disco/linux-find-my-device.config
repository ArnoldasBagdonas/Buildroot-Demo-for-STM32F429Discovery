CONFIG_HIGH_RES_TIMERS=y
CONFIG_POSIX_TIMERS=y
CONFIG_TIMERFD=y
# The external uClibc toolchain calls the legacy time32 timerfd syscalls.
CONFIG_COMPAT_32BIT_TIME=y
CONFIG_NET=y
CONFIG_PACKET=y
# CONFIG_UNIX is not set
CONFIG_INET=y
CONFIG_IP_MULTICAST=y
# CONFIG_INET_DIAG is not set
# CONFIG_IPV6 is not set
# CONFIG_ETHTOOL_NETLINK is not set
# CONFIG_WIRELESS is not set
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_WIZNET=y
CONFIG_WIZNET_W5100=y
CONFIG_WIZNET_BUS_ANY=y
CONFIG_WIZNET_W5100_SPI=y
# CONFIG_PTP_1588_CLOCK is not set
CONFIG_NVMEM=y
CONFIG_NVMEM_SYSFS=y
CONFIG_NVMEM_STM32_ROMEM=y
CONFIG_PROC_FS=y
# Find My Device reads the on-board PA0 USER button and drives the PG13 status
# LED through the GPIO v2 character-device API. Re-enable it after the compact
# SD-card fragment, which disables unused userspace peripheral interfaces.
CONFIG_GPIO_CDEV=y
