# Applied only when BR2_PACKAGE_SDCARD=y.
# The SD-enabled image does not need the IPv4/W5500 stack and omitting
# it leaves enough internal XIP flash for block, MMC-over-SPI, and VFAT.
# CONFIG_NET is not set
CONFIG_BLOCK=y
CONFIG_PARTITION_ADVANCED=y
CONFIG_MSDOS_PARTITION=y
# Keep the mandatory multi-queue block core, but omit desktop/server I/O
# schedulers and unused partition formats from this small single-card system.
# CONFIG_BLOCK_LEGACY_AUTOLOAD is not set
# CONFIG_EFI_PARTITION is not set
# CONFIG_MQ_IOSCHED_DEADLINE is not set
# CONFIG_MQ_IOSCHED_KYBER is not set
# CONFIG_IOSCHED_BFQ is not set
# CONFIG_BLK_DEV is not set
CONFIG_MMC=y
# The removable SPI slot does not need eMMC power-sequencing helpers.
# CONFIG_PWRSEQ_EMMC is not set
# CONFIG_PWRSEQ_SIMPLE is not set
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SPI=y
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y

# The LCD needs DRM, LTDC, SPI and GPIO, but not these other base-image
# peripheral interfaces. DRM selects the I2C core, so only its unused
# userspace interface and STM32F4 controller driver are disabled here. A later
# package fragment may re-enable a stack when that package is selected.
# CONFIG_I2C_CHARDEV is not set
# CONFIG_I2C_STM32F4 is not set
# CONFIG_SPI_SLAVE is not set
# CONFIG_SPI_SPIDEV is not set
# CONFIG_GPIO_CDEV is not set
# CONFIG_PWM is not set
# CONFIG_RTC_CLASS is not set
# CONFIG_NVMEM is not set

# Keep the combined Display + SD image below the internal XIP-flash ceiling.
# The small single-threaded BusyBox/display utilities do not use these
# optional descriptor and userspace-locking syscall families.
# CONFIG_FUTEX is not set
# CONFIG_EPOLL is not set
# CONFIG_TIMERFD is not set
# CONFIG_DEBUG_MEMORY_INIT is not set
# CONFIG_STACKTRACE is not set
