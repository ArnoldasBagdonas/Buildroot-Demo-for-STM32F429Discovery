#!/bin/sh
mount -t devtmpfs devtmpfs /dev
mount -t sysfs sysfs /sys
mount -t proc proc /proc 2>/dev/null || true
export PATH="/bin:/sbin:/usr/bin:/usr/sbin" PS1='# '
mkdir -p /run
for service in /etc/init.d/S??*; do
	[ -x "$service" ] || continue
	"$service" start || true
done
exec setsid cttyhack /bin/sh -i
