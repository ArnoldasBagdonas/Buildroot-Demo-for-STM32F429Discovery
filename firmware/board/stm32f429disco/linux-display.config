# Applied only when BR2_PACKAGE_DISPLAY=y.
CONFIG_FB=y
# Linux 6.1 fbmem_init() creates /proc/fb before the graphics class. Without
# procfs it exits early and DRM cannot create /dev/fb0 (device_create: -ENODEV).
CONFIG_PROC_FS=y
# The STM32 DRM driver gates lcd-tft after probe and restores it through its
# runtime-PM callbacks during the first modeset. With CONFIG_PM disabled the
# pm_runtime helpers are stubs, leaving LTDC enabled without a pixel clock.
CONFIG_PM=y
CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_STM=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_DRM_PANEL_ILITEK_ILI9341=y
