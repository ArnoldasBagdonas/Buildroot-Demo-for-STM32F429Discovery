# Package-specific requirements for the Screen touch console.
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_TOUCHSCREEN=y
# CONFIG_INPUT_KEYBOARD is not set
# CONFIG_INPUT_MOUSE is not set
# CONFIG_INPUT_JOYSTICK is not set
# CONFIG_INPUT_TABLET is not set
# CONFIG_INPUT_MISC is not set
# CONFIG_SERIO is not set
# CONFIG_HID_SUPPORT is not set
CONFIG_MFD_STMPE=y
CONFIG_STMPE_I2C=y
CONFIG_TOUCHSCREEN_STMPE=y

# Screen uses one UNIX98 PTY so the interactive BusyBox shell retains normal
# echo, line editing, Tab, Backspace, and Ctrl-C behavior on no-MMU Linux.
CONFIG_TTY=y
CONFIG_UNIX98_PTYS=y
# CONFIG_LEGACY_PTYS is not set

# I2C3 is already part of the base board, but linux-compact.config disables
# its controller. Keep it built in for STMPE811 and optional 24LC16B sharing.
CONFIG_I2C=y
CONFIG_I2C_STM32F4=y
