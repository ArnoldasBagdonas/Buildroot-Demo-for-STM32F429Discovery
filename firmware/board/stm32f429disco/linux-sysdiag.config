# Applied only when BR2_PACKAGE_SYSDIAG=y.
# Keep kernel diagnostics out of both the minimal and normal display images.
CONFIG_PROC_FS=y
CONFIG_DEBUG_KERNEL=y
CONFIG_DEBUG_FS=y
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_LOG_BUF_SHIFT=14
CONFIG_PROC_SYSCTL=y
CONFIG_DEBUG_MEMORY_INIT=y
CONFIG_STACKTRACE=y
CONFIG_MAGIC_SYSRQ=y

# Restore the base userspace hardware interfaces when sysdiag is combined with
# a size-oriented example image.
CONFIG_HIGH_RES_TIMERS=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_TIMERFD=y
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_INET=y
CONFIG_NETDEVICES=y
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_STM32F4=y
CONFIG_SPI=y
CONFIG_SPI_STM32=y
CONFIG_SPI_SPIDEV=y
CONFIG_GPIO_CDEV=y
CONFIG_DEVMEM=y
CONFIG_MFD_STM32_TIMERS=y
CONFIG_PWM=y
CONFIG_PWM_STM32=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_STM32=y
CONFIG_NVMEM=y
CONFIG_NVMEM_SYSFS=y
CONFIG_NVMEM_STM32_ROMEM=y
