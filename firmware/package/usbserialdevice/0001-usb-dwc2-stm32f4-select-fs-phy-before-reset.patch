From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Buildroot Demo <noreply@example.com>
Date: Fri, 7 Aug 2026 15:40:00 +0000
Subject: [PATCH] usb: dwc2: initialize STM32F4 embedded FS PHY in ST order

The STM32F429 Discovery USB USER connector is attached to the OTG HS
controller through its embedded full-speed PHY.  The platform probe resets
the core before the STM32-specific parameters select that PHY.  On a cold
boot the reset can therefore time out:

  dwc2_core_reset: HANG! Soft Reset timeout GRSTCTL_CSFTRST

Follow the sequence used by the STM32CubeF4 HAL for this integration:

  1. select the embedded full-speed PHY;
  2. wait for the AHB master to become idle;
  3. allow the selection to settle and reset the core;
  4. power the embedded transceiver;
  5. disable hardware VBUS sensing for peripheral-only operation.

Powering the transceiver before reset is deliberately avoided because it is
not the sequence required by the STM32F4 reference implementation.  The
later parameter-driven PHY initialization remains idempotent.

Signed-off-by: Buildroot Demo <noreply@example.com>
---
 drivers/usb/dwc2/hw.h       |  3 +++
 drivers/usb/dwc2/platform.c | 36 ++++++++++++++++++++++++++++++++++++
 2 files changed, 39 insertions(+)

diff --git a/drivers/usb/dwc2/hw.h b/drivers/usb/dwc2/hw.h
index 13abdd5f6756..3136dc8e4382 100644
--- a/drivers/usb/dwc2/hw.h
+++ b/drivers/usb/dwc2/hw.h
@@ -205,6 +205,9 @@
 #define GGPIO_STM32_OTG_GCCFG_PWRDWN	BIT(16)
 #define GGPIO_STM32_OTG_GCCFG_VBDEN	BIT(21)
 #define GGPIO_STM32_OTG_GCCFG_IDEN	BIT(22)
+#define GGPIO_STM32F4_OTG_GCCFG_VBUSASEN	BIT(18)
+#define GGPIO_STM32F4_OTG_GCCFG_VBUSBSEN	BIT(19)
+#define GGPIO_STM32F4_OTG_GCCFG_NOVBUSSENS	BIT(21)
 
 #define GUID				HSOTG_REG(0x003c)
 #define GSNPSID				HSOTG_REG(0x0040)
diff --git a/drivers/usb/dwc2/platform.c b/drivers/usb/dwc2/platform.c
index 262c13b636e0..b1971d3a6718 100644
--- a/drivers/usb/dwc2/platform.c
+++ b/drivers/usb/dwc2/platform.c
@@ -6,6 +6,7 @@
  */
 
 #include <linux/kernel.h>
+#include <linux/delay.h>
 #include <linux/module.h>
 #include <linux/slab.h>
 #include <linux/clk.h>
@@ -396,6 +397,7 @@ static int dwc2_driver_probe(struct platform_device *dev)
 	struct dwc2_hsotg *hsotg;
 	struct resource *res;
 	int retval;
+	bool stm32f4_fsotg;
 
 	hsotg = devm_kzalloc(&dev->dev, sizeof(*hsotg), GFP_KERNEL);
 	if (!hsotg)
@@ -469,6 +471,28 @@ static int dwc2_driver_probe(struct platform_device *dev)
 	if (retval)
 		goto error;
 
+	stm32f4_fsotg = of_device_is_compatible(dev->dev.of_node,
+						 "st,stm32f4x9-fsotg");
+	if (stm32f4_fsotg) {
+		u32 gusbcfg = dwc2_readl(hsotg, GUSBCFG);
+
+		/* Select the embedded FS PHY before the first core reset. */
+		gusbcfg |= GUSBCFG_PHYSEL;
+		dwc2_writel(hsotg, gusbcfg, GUSBCFG);
+
+		/* STM32 requires the AHB master to be idle before reset. */
+		if (dwc2_hsotg_wait_bit_set(hsotg, GRSTCTL,
+					     GRSTCTL_AHBIDLE, 10000)) {
+			dev_warn(hsotg->dev,
+				 "STM32F4 AHB master did not become idle before reset\n");
+			retval = -EBUSY;
+			goto error;
+		}
+
+		/* STM32CubeF4 leaves a few cycles after selecting the PHY. */
+		udelay(1);
+	}
+
 	/*
 	 * Reset before dwc2_get_hwparams() then it could get power-on real
 	 * reset value form registers.
@@ -478,6 +502,18 @@ static int dwc2_driver_probe(struct platform_device *dev)
 	if (retval)
 		goto error;
 
+	if (stm32f4_fsotg) {
+		u32 ggpio = dwc2_readl(hsotg, GGPIO);
+
+		/* Activate the transceiver only after reset, as required by ST. */
+		ggpio |= GGPIO_STM32_OTG_GCCFG_PWRDWN;
+		/* Peripheral-only operation does not depend on the VBUS pin. */
+		ggpio |= GGPIO_STM32F4_OTG_GCCFG_NOVBUSSENS;
+		ggpio &= ~(GGPIO_STM32F4_OTG_GCCFG_VBUSASEN |
+			   GGPIO_STM32F4_OTG_GCCFG_VBUSBSEN);
+		dwc2_writel(hsotg, ggpio, GGPIO);
+	}
+
 	/* Detect config values from hardware */
 	retval = dwc2_get_hwparams(hsotg);
 	if (retval)
-- 
2.39.5
