#!/bin/sh

DAEMON=/usr/sbin/sdcard
PIDFILE=/run/sdcard.pid

is_running()
{
	start-stop-daemon -K -t -q -p "$PIDFILE"
}

start()
{
	printf 'Starting sdcard watcher: '
	if is_running; then
		echo 'already running'
		return 0
	fi
	rm -f "$PIDFILE"
	if start-stop-daemon -S -q -b -m -p "$PIDFILE" -x "$DAEMON" -- watch; then
		echo 'OK'
	else
		echo 'FAIL'
		return 1
	fi
}

stop()
{
	printf 'Stopping sdcard watcher: '
	if is_running; then
		start-stop-daemon -K -q -p "$PIDFILE"
	fi
	rm -f "$PIDFILE"
	echo 'OK'
}

status()
{
	if is_running; then
		echo "sdcard watcher: running (PID $(cat "$PIDFILE"))"
	else
		echo 'sdcard watcher: stopped'
	fi
	"$DAEMON" status
}

case "${1:-}" in
	start) start ;;
	stop) stop ;;
	restart) stop; start ;;
	status) status ;;
	*) echo "Usage: $0 {start|stop|restart|status}" >&2; exit 2 ;;
esac
