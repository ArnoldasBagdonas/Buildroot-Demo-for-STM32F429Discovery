#!/bin/sh

set -e

MTD_NAME=ubi
UBI_NUM=0
VOLUME_NAME=data
MOUNT_POINT=/mnt/spinand
BOOT_WAIT_SECONDS=${SPINAND_BOOT_WAIT:-2}
BOOT_STATUS=/var/run/spinand-ubi.status
FASTMAP_MARKER=/etc/spinand-ubi-fastmap
FASTMAP_PARAMETER=/sys/module/ubi/parameters/fm_autoconvert

find_mtd_num()
{
	for name_file in /sys/class/mtd/mtd*/name; do
		[ -r "$name_file" ] || continue
		read -r mtd_name < "$name_file"
		if [ "$mtd_name" = "$MTD_NAME" ]; then
			mtd=${name_file%/name}
			mtd=${mtd%/}
			mtd=${mtd##*/mtd}
			MTD_NUM=$mtd
			return 0
		fi
	done
	return 1
}

require_mtd()
{
	find_mtd_num || {
		echo "SPI-NAND MTD partition '$MTD_NAME' was not found." >&2
		echo "Check the wiring and that the -spinand DTB was flashed." >&2
		exit 1
	}
	MTD_DEV=/dev/mtd${MTD_NUM}
}

wait_for_mtd()
{
	waited=0
	while ! find_mtd_num && [ "$waited" -lt "$BOOT_WAIT_SECONDS" ]; do
		sleep 1
		waited=$((waited + 1))
	done
	find_mtd_num || return 1
	MTD_DEV=/dev/mtd${MTD_NUM}
}

ubi_is_attached()
{
	[ -r "/sys/class/ubi/ubi${UBI_NUM}/mtd_num" ] &&
		[ "$(cat "/sys/class/ubi/ubi${UBI_NUM}/mtd_num")" = "$MTD_NUM" ]
}

is_mounted()
{
	grep -q " $MOUNT_POINT " /proc/mounts 2>/dev/null
}

configure_fastmap()
{
	[ -e "$FASTMAP_MARKER" ] || return 0
	if [ ! -w "$FASTMAP_PARAMETER" ]; then
		echo "UBI fastmap was selected, but fm_autoconvert is unavailable." >&2
		return 1
	fi
	echo 1 > "$FASTMAP_PARAMETER"
}

attach_ubi()
{
	if ubi_is_attached; then
		return 0
	fi
	if [ -e "/sys/class/ubi/ubi${UBI_NUM}" ]; then
		echo "ubi${UBI_NUM} is already assigned to another MTD device." >&2
		return 1
	fi
	configure_fastmap || return 1
	ubiattach -m "$MTD_NUM" -d "$UBI_NUM" /dev/ubi_ctrl
}

suggest_format()
{
	echo "SPI-NAND was detected, but it has no usable UBI '$VOLUME_NAME' volume." >&2
	echo "Inspect it without changing data: spinand-ubi status" >&2
	echo "To erase and initialize it once: spinand-ubi format --yes" >&2
}

show_status()
{
	require_mtd
	echo "MTD device: $MTD_DEV"
	for item in name size erasesize writesize oobsize; do
		[ -r "/sys/class/mtd/mtd${MTD_NUM}/$item" ] || continue
		printf '%-10s %s\n' "$item:" "$(cat "/sys/class/mtd/mtd${MTD_NUM}/$item")"
	done
	if ubi_is_attached; then
		echo "UBI device: /dev/ubi${UBI_NUM}"
	else
		echo "UBI device: detached"
	fi
	if is_mounted; then
		echo "UBIFS:     mounted at $MOUNT_POINT"
	else
		echo "UBIFS:     not mounted"
	fi
	if [ -e "$FASTMAP_MARKER" ]; then
		echo "Fastmap:   requested (experimental)"
	else
		echo "Fastmap:   disabled"
	fi
}

mount_volume()
{
	require_mtd
	if ! ubi_is_attached; then
		echo "SPI-NAND: attaching UBI to $MTD_DEV synchronously; scanning may take a while..."
	fi
	if ! attach_ubi; then
		echo "SPI-NAND: UBI attach failed; persistent volume is unavailable." >&2
		suggest_format
		return 1
	fi
	if [ ! -e "/sys/class/ubi/ubi${UBI_NUM}_0" ]; then
		echo "SPI-NAND: UBI attached, but the '$VOLUME_NAME' volume is unavailable." >&2
		suggest_format
		return 1
	fi
	mkdir -p "$MOUNT_POINT"
	if ! is_mounted; then
		echo "SPI-NAND: mounting UBIFS from ubi${UBI_NUM}:$VOLUME_NAME..."
		if ! mount -t ubifs "ubi${UBI_NUM}:$VOLUME_NAME" "$MOUNT_POINT"; then
			echo "SPI-NAND: UBIFS mount failed; persistent volume is unavailable." >&2
			return 1
		fi
	fi
	echo "SPI-NAND: UBIFS mount succeeded at $MOUNT_POINT."
}

auto_mount_volume()
{
	mkdir -p /var/run
	echo "SPI-NAND: boot-time detection, UBI attach, and synchronous mount started."
	echo checking > "$BOOT_STATUS"
	if ! wait_for_mtd; then
		echo "SPI-NAND MTD partition '$MTD_NAME' was not detected during boot." >&2
		echo "Check the wiring and that the -spinand DTB was flashed." >&2
		echo "SPI-NAND: boot-time mount failed; boot will continue without this volume." >&2
		echo missing > "$BOOT_STATUS"
		return 1
	fi
	if mount_volume; then
		echo "SPI-NAND: boot-time mount completed successfully."
		echo mounted > "$BOOT_STATUS"
		return 0
	fi
	echo "SPI-NAND: boot-time mount failed; boot will continue without this volume." >&2
	echo unavailable > "$BOOT_STATUS"
	return 1
}

format_volume()
{
	[ "${1:-}" = "--yes" ] || {
		echo "This erases the complete 32 MiB '$MTD_NAME' partition." >&2
		echo "Repeat with: spinand-ubi format --yes" >&2
		exit 2
	}
	require_mtd
	if is_mounted; then
		umount "$MOUNT_POINT"
	fi
	if ubi_is_attached; then
		ubidetach -d "$UBI_NUM" /dev/ubi_ctrl
	fi
	echo "Erasing $MTD_DEV..."
	flash_eraseall "$MTD_DEV"
	echo "Creating UBI device and '$VOLUME_NAME' volume..."
	attach_ubi
	ubimkvol -N "$VOLUME_NAME" -m "/dev/ubi${UBI_NUM}"
	mount_volume
}

case "${1:-status}" in
	status)
		show_status
		;;
	mount)
		mount_volume
		;;
	auto)
		auto_mount_volume
		;;
	format)
		format_volume "${2:-}"
		;;
	unmount)
		if is_mounted; then
			umount "$MOUNT_POINT"
		fi
		if [ -r "/sys/class/ubi/ubi${UBI_NUM}/mtd_num" ]; then
			ubidetach -d "$UBI_NUM" /dev/ubi_ctrl
		fi
		;;
	*)
		echo "Usage: spinand-ubi {status|mount|auto|format --yes|unmount}" >&2
		exit 2
		;;
esac
