#!/bin/sh

delay_seconds="${1:-3}"
image_directory="${2:-/usr/share/displayexample}"

case "${delay_seconds}" in
	''|*[!0-9]*)
		echo "Usage: displayexample [delay-seconds] [image-directory]" >&2
		exit 2
		;;
esac

if [ ! -c /dev/fb0 ]; then
	echo "displayexample: /dev/fb0 is missing" >&2
	echo "Check that the display example was selected before building and flashing." >&2
	exit 1
fi

# With no framebuffer console, DRM registers fb0 but does not perform its
# first modeset. Re-applying the advertised mode activates LTDC and prepares
# the ILI9341 before fbv writes the first image.
mode_file=/sys/class/graphics/fb0/mode
modes_file=/sys/class/graphics/fb0/modes
if [ -r "${mode_file}" ] && [ -w "${mode_file}" ]; then
	IFS= read -r display_mode < "${mode_file}"
	# The current mode is empty until DRM performs its first modeset. In that
	# case select the first mode exported by the connector instead of assuming
	# that the display is already active.
	if [ -z "${display_mode}" ] && [ -r "${modes_file}" ]; then
		IFS= read -r display_mode < "${modes_file}"
	fi
	if [ -n "${display_mode}" ]; then
		if ! echo "${display_mode}" > "${mode_file}"; then
			echo "displayexample: failed to activate display mode ${display_mode}" >&2
			exit 1
		fi
	fi
fi

if [ ! -d "${image_directory}" ]; then
	echo "displayexample: image directory not found: ${image_directory}" >&2
	exit 1
fi

set --
for image in \
	"${image_directory}"/*.png \
	"${image_directory}"/*.jpg \
	"${image_directory}"/*.jpeg \
	"${image_directory}"/*.gif \
	"${image_directory}"/*.bmp
do
	[ -f "${image}" ] || continue
	set -- "$@" "${image}"
done

if [ "$#" -eq 0 ]; then
	echo "displayexample: no PNG, JPEG, GIF, or BMP images in ${image_directory}" >&2
	exit 1
fi

# Avoid shell arithmetic here. BusyBox hush attempts to re-execute itself for
# this expansion on the no-MMU target, but uClinux cannot implement exec for a
# dynamically linked process. The value has already been validated as decimal,
# so appending one zero is the exact seconds-to-tenths conversion we need.
delay_tenths="${delay_seconds}0"

echo "Showing $# image(s) from ${image_directory}; delay ${delay_seconds}s."
echo "Press q to quit, Space/Enter for the next image, or </> to navigate."

# fbv uses the legacy framebuffer API. -k fits oversized images using its
# color-average scaler, -e enlarges small images, and -s uses tenths of seconds.
# The UART is the command console, not a local framebuffer VT. Keep its scrollback
# and cursor intact while fbv owns raw input for slideshow navigation.
exec fbv -c -u -i -k -e -s "${delay_tenths}" "$@"
