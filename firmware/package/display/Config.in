config BR2_PACKAGE_DISPLAY
	bool "Display: PNG/JPEG/GIF/BMP slideshow"
	depends on !BR2_PACKAGE_GALLERY_PROVIDES_DISPLAY
	depends on !BR2_PACKAGE_FIRMWARE_SCREEN
	select BR2_PACKAGE_FBV
	select BR2_PACKAGE_FBV_PNG
	select BR2_PACKAGE_FBV_JPEG
	select BR2_PACKAGE_FBV_GIF
	help
	  Enable the STM32F429Discovery LCD and install a small slideshow
	  example. The example uses fbv with PNG, JPEG, and GIF support and
	  includes one 240x320 test image in each format. fbv's built-in BMP
	  support is also available without another decoder library.

	  Selecting this package also applies the required Linux DRM/fbdev
	  configuration fragment. The shared board device tree already describes
	  the display hardware.

	  When this package is not selected, the display drivers, fbv, image
	  decoder libraries, display utility, and sample images are excluded from
	  the firmware image. The device-tree nodes remain inactive because their
	  kernel drivers are not enabled.

	  The independent BR2_PACKAGE_SYSDIAG package may be selected beside
	  this or any other example when reusable diagnostics are needed.

	  Select Gallery for the BusyBox-style executable example. Its optional
	  SD-card suboption combines Display and SD-card applets in that binary.

comment "Standalone Display is disabled by Gallery"
	depends on BR2_PACKAGE_GALLERY

comment "Standalone Display is disabled by Screen"
	depends on BR2_PACKAGE_FIRMWARE_SCREEN

if BR2_PACKAGE_DISPLAY

menu "Display options"

config BR2_PACKAGE_DISPLAY_COMPRESS_INITRAMFS
	bool "Compress the initramfs with gzip (NEW)"
	default y
	help
	  Store the embedded root filesystem as a gzip-compressed archive in
	  internal flash. Linux expands it into RAM during boot; the kernel
	  remains an XIP image and continues executing directly from flash.

config BR2_PACKAGE_DISPLAY_AUTOSTART
	bool "Start the image slideshow automatically at boot"
	default y
	help
	  Install the package-owned /etc/init.d/S30display service. The
	  standalone Display example always uses its bundled test images unless
	  an explicit directory is passed to display.

	  The viewer runs in non-interactive mode and does not consume input
	  from the serial console. Use the service script's status or stop
	  operation before manual framebuffer testing.

endmenu

endif
