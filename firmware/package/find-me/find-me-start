#!/bin/sh

set -e

if [ -r /etc/find-me.conf ]; then
	. /etc/find-me.conf
fi

FMD_INTERFACE=${FMD_INTERFACE:-eth0}
FMD_HTTP_PORT=${FMD_HTTP_PORT:-8080}
FMD_DEVICE_NAME=${FMD_DEVICE_NAME:-My Finder}
FMD_DEVICE_MODEL=${FMD_DEVICE_MODEL:-FINDER-R01}
FMD_STATE_FILE=${FMD_STATE_FILE:-auto}
FMD_FRAM_STATE_DEVICE=${FMD_FRAM_STATE_DEVICE:-auto}
FMD_FRAM_WAIT=${FMD_FRAM_WAIT:-3}
FMD_EEPROM_STATE_DEVICE=${FMD_EEPROM_STATE_DEVICE:-auto}
FMD_EEPROM_WAIT=${FMD_EEPROM_WAIT:-3}
FMD_SPINOR_RAW_DEVICE=${FMD_SPINOR_RAW_DEVICE:-auto}
FMD_SPINOR_RAW_WAIT=${FMD_SPINOR_RAW_WAIT:-3}
FMD_SDCARD_STATE_FILE=${FMD_SDCARD_STATE_FILE:-/mnt/sdcard/find-me/state}
FMD_SDCARD_WAIT=${FMD_SDCARD_WAIT:-10}
FMD_SPINOR_STATE_FILE=${FMD_SPINOR_STATE_FILE:-/mnt/spinor/find-me/state}
FMD_SPINOR_WAIT=${FMD_SPINOR_WAIT:-10}
FMD_SPINAND_STATE_FILE=${FMD_SPINAND_STATE_FILE:-/mnt/spinand/find-me/state}
FMD_SPINAND_WAIT=${FMD_SPINAND_WAIT:-10}
FMD_BUTTON_CHIP=${FMD_BUTTON_CHIP:-/dev/gpiochip0}
FMD_BUTTON_LINE=${FMD_BUTTON_LINE:-0}
FMD_BUTTON_ACTIVE_LOW=${FMD_BUTTON_ACTIVE_LOW:-no}
FMD_LED_CHIP=${FMD_LED_CHIP:-/dev/gpiochip6}
FMD_LED_LINE=${FMD_LED_LINE:-13}
FMD_GPIO_ENABLED=${FMD_GPIO_ENABLED:-yes}
FMD_DHCP_WAIT=${FMD_DHCP_WAIT:-30}

fmd_mountpoint_mounted()
{
	FMD_CHECK_MOUNT=$1
	while read -r FMD_MOUNT_SOURCE FMD_MOUNT_TARGET FMD_MOUNT_REST; do
		if [ "${FMD_MOUNT_TARGET}" = "${FMD_CHECK_MOUNT}" ]; then
			return 0
		fi
	done < /proc/mounts
	return 1
}

fmd_find_fram()
{
	if [ "${FMD_FRAM_STATE_DEVICE}" != auto ]; then
		if [ -r "${FMD_FRAM_STATE_DEVICE}" ] && [ -w "${FMD_FRAM_STATE_DEVICE}" ]; then
			FMD_FRAM_DEVICE=${FMD_FRAM_STATE_DEVICE}
			return 0
		fi
		return 1
	fi
	for FMD_FRAM_CANDIDATE in /sys/bus/spi/devices/*/fram; do
		if [ -r "${FMD_FRAM_CANDIDATE}" ] && [ -w "${FMD_FRAM_CANDIDATE}" ]; then
			FMD_FRAM_DEVICE=${FMD_FRAM_CANDIDATE}
			return 0
		fi
	done
	return 1
}

fmd_find_eeprom()
{
	if [ "${FMD_EEPROM_STATE_DEVICE}" != auto ]; then
		if [ -r "${FMD_EEPROM_STATE_DEVICE}" ] && [ -w "${FMD_EEPROM_STATE_DEVICE}" ]; then
			FMD_EEPROM_DEVICE=${FMD_EEPROM_STATE_DEVICE}
			return 0
		fi
		return 1
	fi
	for FMD_EEPROM_CANDIDATE in \
		/sys/bus/nvmem/devices/find-me-eeprom*/nvmem \
		/sys/bus/i2c/devices/*-0050/eeprom; do
		if [ -r "${FMD_EEPROM_CANDIDATE}" ] && [ -w "${FMD_EEPROM_CANDIDATE}" ]; then
			FMD_EEPROM_DEVICE=${FMD_EEPROM_CANDIDATE}
			return 0
		fi
	done
	return 1
}

fmd_find_spinor_raw()
{
	if [ "${FMD_SPINOR_RAW_DEVICE}" != auto ]; then
		if [ -r "${FMD_SPINOR_RAW_DEVICE}" ] && [ -w "${FMD_SPINOR_RAW_DEVICE}" ]; then
			FMD_SPINOR_RAW_MTD=${FMD_SPINOR_RAW_DEVICE}
			return 0
		fi
		return 1
	fi
	for FMD_SPINOR_NAME_FILE in /sys/class/mtd/mtd*/name; do
		[ -r "${FMD_SPINOR_NAME_FILE}" ] || continue
		read -r FMD_SPINOR_NAME < "${FMD_SPINOR_NAME_FILE}"
		[ "${FMD_SPINOR_NAME}" = find-me-state ] || continue
		FMD_SPINOR_MTD_DIR=${FMD_SPINOR_NAME_FILE%/name}
		FMD_SPINOR_RAW_MTD=/dev/${FMD_SPINOR_MTD_DIR##*/}
		if [ -r "${FMD_SPINOR_RAW_MTD}" ] && [ -w "${FMD_SPINOR_RAW_MTD}" ]; then
			return 0
		fi
	done
	return 1
}

FMD_STATE_BACKEND=configured
FMD_STATE_MODE_ARGS=
if [ "${FMD_STATE_FILE}" = auto ]; then
	FMD_STATE_FILE=/var/lib/find-me/state
	FMD_STATE_BACKEND=ram
	if [ -e /etc/find-me-fram ]; then
		FMD_WAIT=0
		set +e
		while ! fmd_find_fram && [ "${FMD_WAIT}" -lt "${FMD_FRAM_WAIT}" ]; do
			sleep 1
			FMD_WAIT=$((FMD_WAIT + 1))
		done
		set -e
		if fmd_find_fram; then
			FMD_STATE_FILE=${FMD_FRAM_DEVICE}
			FMD_STATE_BACKEND=fram
			FMD_STATE_MODE_ARGS=--state-fram
		else
			echo "find-me: CY15B256Q FRAM is not available; trying other storage" >&2
		fi
	fi
	if [ "${FMD_STATE_BACKEND}" = ram ] && [ -e /etc/find-me-eeprom ]; then
		FMD_WAIT=0
		set +e
		while ! fmd_find_eeprom && [ "${FMD_WAIT}" -lt "${FMD_EEPROM_WAIT}" ]; do
			sleep 1
			FMD_WAIT=$((FMD_WAIT + 1))
		done
		set -e
		if fmd_find_eeprom; then
			FMD_STATE_FILE=${FMD_EEPROM_DEVICE}
			FMD_STATE_BACKEND=eeprom
			FMD_STATE_MODE_ARGS=--state-eeprom
		else
			echo "find-me: 24LC16B EEPROM is not available; trying other storage" >&2
		fi
	fi
	if [ "${FMD_STATE_BACKEND}" = ram ] && [ -e /etc/find-me-spinor-state ]; then
		FMD_WAIT=0
		set +e
		while ! fmd_find_spinor_raw && [ "${FMD_WAIT}" -lt "${FMD_SPINOR_RAW_WAIT}" ]; do
			sleep 1
			FMD_WAIT=$((FMD_WAIT + 1))
		done
		set -e
		if fmd_find_spinor_raw; then
			FMD_STATE_FILE=${FMD_SPINOR_RAW_MTD}
			FMD_STATE_BACKEND=spinor-raw
			FMD_STATE_MODE_ARGS=--state-spinor
		else
			echo "find-me: raw W25Q128FV state partition is unavailable; trying mounted storage" >&2
		fi
	fi
	if [ "${FMD_STATE_BACKEND}" = ram ] && [ -x /usr/sbin/sdcard ]; then
		# This also supports starting find-me manually before the boot
		# watcher has completed its first mount attempt.
		/usr/sbin/sdcard mount >/dev/null 2>&1 || true
		FMD_WAIT=0
		set +e
		while ! fmd_mountpoint_mounted /mnt/sdcard &&
			[ "${FMD_WAIT}" -lt "${FMD_SDCARD_WAIT}" ]; do
			sleep 1
			FMD_WAIT=$((FMD_WAIT + 1))
		done
		set -e
		if fmd_mountpoint_mounted /mnt/sdcard; then
			FMD_STATE_FILE=${FMD_SDCARD_STATE_FILE}
			FMD_STATE_BACKEND=sdcard
		fi
	fi
	if [ "${FMD_STATE_BACKEND}" = ram ] && [ -x /usr/sbin/spinor-jffs2 ]; then
		# The boot helper mounts initialized volumes before this service. When
		# automount is disabled, try the same non-destructive mount explicitly.
		if [ ! -x /usr/sbin/spinor-jffs2-auto ]; then
			/usr/sbin/spinor-jffs2 mount >/dev/null 2>&1 || true
		fi
		FMD_WAIT=0
		set +e
		while ! fmd_mountpoint_mounted /mnt/spinor &&
			[ "${FMD_WAIT}" -lt "${FMD_SPINOR_WAIT}" ]; do
			if [ -r /var/run/spinor-jffs2.status ]; then
				read -r FMD_SPINOR_STATUS < /var/run/spinor-jffs2.status
				case "${FMD_SPINOR_STATUS}" in
					missing|unavailable) break ;;
				esac
			fi
			sleep 1
			FMD_WAIT=$((FMD_WAIT + 1))
		done
		set -e
		if fmd_mountpoint_mounted /mnt/spinor; then
			FMD_STATE_FILE=${FMD_SPINOR_STATE_FILE}
			FMD_STATE_BACKEND=spinor
		fi
	fi
	if [ "${FMD_STATE_BACKEND}" = ram ] && [ -x /usr/sbin/spinand-ubi ]; then
		# The package's boot helper normally mounts UBIFS before this service.
		# If automount was disabled, explicitly try the same non-destructive mount.
		if [ ! -x /usr/sbin/spinand-ubi-auto ]; then
			/usr/sbin/spinand-ubi mount >/dev/null 2>&1 || true
		fi
		FMD_WAIT=0
		set +e
		while ! fmd_mountpoint_mounted /mnt/spinand &&
			[ "${FMD_WAIT}" -lt "${FMD_SPINAND_WAIT}" ]; do
			if [ -r /var/run/spinand-ubi.status ]; then
				read -r FMD_SPINAND_STATUS < /var/run/spinand-ubi.status
				case "${FMD_SPINAND_STATUS}" in
					missing|unavailable) break ;;
				esac
			fi
			sleep 1
			FMD_WAIT=$((FMD_WAIT + 1))
		done
		set -e
		if fmd_mountpoint_mounted /mnt/spinand; then
			FMD_STATE_FILE=${FMD_SPINAND_STATE_FILE}
			FMD_STATE_BACKEND=spinand
		fi
	fi
	if [ "${FMD_STATE_BACKEND}" = ram ]; then
		echo "find-me: no persistent storage is mounted; state is temporary" >&2
	fi
fi

case "${FMD_STATE_BACKEND}" in
	fram|eeprom|spinor-raw) ;;
	*)
		FMD_STATE_DIRECTORY=${FMD_STATE_FILE%/*}
		if [ -z "${FMD_STATE_DIRECTORY}" ] || [ "${FMD_STATE_DIRECTORY}" = "${FMD_STATE_FILE}" ]; then
			echo "find-me: state path must include a directory: ${FMD_STATE_FILE}" >&2
			exit 1
		fi
		mkdir -p "${FMD_STATE_DIRECTORY}"
		;;
esac
mkdir -p /var/run
echo "find_me_state=${FMD_STATE_FILE} backend=${FMD_STATE_BACKEND}"

# SPI Ethernet probes asynchronously. Give it a short bounded wait so a
# missing or miswired module never prevents the console shell from starting.
FMD_WAIT=0
# BusyBox hush incorrectly applies `set -e` to the final false condition of
# these bounded waits, so disable it only while waiting.
set +e
while [ ! -d "/sys/class/net/${FMD_INTERFACE}" ] && [ "${FMD_WAIT}" -lt 10 ]; do
	sleep 1
	FMD_WAIT=$((FMD_WAIT + 1))
done
set -e
if [ ! -d "/sys/class/net/${FMD_INTERFACE}" ]; then
	echo "find-me: ${FMD_INTERFACE} was not created; check W5500 wiring and the boot log" >&2
	exit 1
fi

if ! FMD_MAC_RESULT=$(/usr/bin/find-me \
	--interface "${FMD_INTERFACE}" --prepare-interface 2>&1); then
	echo "find-me: ${FMD_MAC_RESULT}" >&2
	exit 1
fi
echo "${FMD_MAC_RESULT}"

ifconfig "${FMD_INTERFACE}" up

FMD_MAC=${FMD_MAC_RESULT#*=}
# Use an opaque, deterministic client identifier distinct from BusyBox's
# default type-1 MAC identifier. This survives reboot while avoiding stale
# leases left by older images which used the default identifier.
FMD_DHCP_CLIENT_ID="00${FMD_MAC//:/}"
: > /var/run/find-me.ipv4
# Keep udhcpc alive so it renews leases and retries after a late cable insert.
# -f prevents its no-MMU daemon re-exec; the shell backgrounds it explicitly.
udhcpc -f -i "${FMD_INTERFACE}" -s /usr/share/find-me/udhcpc.script \
	-x "0x3d:${FMD_DHCP_CLIENT_ID}" -t 4 -T 2 -A 5 &
echo $! > /var/run/find-me.udhcpc.pid

FMD_WAIT=0
set +e
while [ ! -s /var/run/find-me.ipv4 ] && [ "${FMD_WAIT}" -lt "${FMD_DHCP_WAIT}" ]; do
	sleep 1
	FMD_WAIT=$((FMD_WAIT + 1))
done
set -e
if [ ! -s /var/run/find-me.ipv4 ]; then
	# A deterministic RFC 3927 address keeps direct-cable and isolated-switch
	# testing useful while the persistent DHCP client continues retrying.
	FMD_OLD_IFS=${IFS}
	IFS=:
	set -- ${FMD_MAC}
	IFS=${FMD_OLD_IFS}
	FMD_LL3=$((0x$5))
	FMD_LL4=$((0x$6))
	[ "${FMD_LL3}" -eq 0 ] && FMD_LL3=1
	[ "${FMD_LL3}" -eq 255 ] && FMD_LL3=254
	[ "${FMD_LL4}" -eq 0 ] && FMD_LL4=1
	[ "${FMD_LL4}" -eq 255 ] && FMD_LL4=254
	FMD_ADDRESS="169.254.${FMD_LL3}.${FMD_LL4}"
	ifconfig "${FMD_INTERFACE}" "${FMD_ADDRESS}" netmask 255.255.0.0 up
	echo "find_me_ipv4=${FMD_ADDRESS} source=link-local-fallback"
fi

FMD_GPIO_ARGS="--no-gpio"
if [ "${FMD_GPIO_ENABLED}" = yes ]; then
	FMD_GPIO_ARGS="--button-chip ${FMD_BUTTON_CHIP} --button-line ${FMD_BUTTON_LINE} --led-chip ${FMD_LED_CHIP} --led-line ${FMD_LED_LINE}"
	if [ "${FMD_BUTTON_ACTIVE_LOW}" = yes ]; then
		FMD_GPIO_ARGS="${FMD_GPIO_ARGS} --button-active-low"
	fi
fi

echo $$ > /var/run/find-me.pid
# FMD_GPIO_ARGS is intentionally word-split into daemon options.
# shellcheck disable=SC2086
exec /usr/bin/find-me \
	--interface "${FMD_INTERFACE}" \
	--port "${FMD_HTTP_PORT}" \
	--state "${FMD_STATE_FILE}" \
	${FMD_STATE_MODE_ARGS} \
	--name "${FMD_DEVICE_NAME}" \
	--model "${FMD_DEVICE_MODEL}" \
	${FMD_GPIO_ARGS}
