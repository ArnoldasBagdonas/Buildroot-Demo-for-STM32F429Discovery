#!/bin/sh

DAEMON=/usr/bin/find-me-start
PIDFILE=/run/find-me.pid
DHCP_PIDFILE=/run/find-me.udhcpc.pid

is_running()
{
	start-stop-daemon -K -t -q -p "$PIDFILE"
}

start()
{
	printf 'Starting find-me: '
	if is_running; then
		echo 'already running'
		return 0
	fi
	rm -f "$PIDFILE"
	if start-stop-daemon -S -q -b -m -p "$PIDFILE" -x "$DAEMON"; then
		echo 'OK'
	else
		echo 'FAIL'
		return 1
	fi
}

stop_pidfile()
{
	pidfile=$1
	if [ -r "$pidfile" ]; then
		start-stop-daemon -K -q -p "$pidfile" || true
		rm -f "$pidfile"
	fi
}

stop()
{
	printf 'Stopping find-me: '
	stop_pidfile "$PIDFILE"
	stop_pidfile "$DHCP_PIDFILE"
	rm -f /run/find-me.ipv4
	echo 'OK'
}

status()
{
	if is_running; then
		echo "find-me: running (PID $(cat "$PIDFILE"))"
		return 0
	fi
	echo 'find-me: stopped'
	return 1
}

case "${1:-}" in
	start) start ;;
	stop) stop ;;
	restart) stop; start ;;
	status) status ;;
	*) echo "Usage: $0 {start|stop|restart|status}" >&2; exit 2 ;;
esac
