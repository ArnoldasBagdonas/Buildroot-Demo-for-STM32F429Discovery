config BR2_PACKAGE_GALLERY_PROVIDES_DISPLAY
	bool

config BR2_PACKAGE_GALLERY
	bool "Gallery: PNG/JPEG/GIF/BMP slideshow"
	depends on !BR2_PACKAGE_FIRMWARE_SCREEN
	select BR2_PACKAGE_GALLERY_PROVIDES_DISPLAY
	select BR2_PACKAGE_FBV
	select BR2_PACKAGE_FBV_PNG
	select BR2_PACKAGE_FBV_JPEG
	select BR2_PACKAGE_FBV_GIF
	help
	  Install the Display slideshow as one BusyBox-style executable with
	  gallery, display, and display-pattern applet names. Its optional
	  features add automatic startup and SD-card image support.

	  By default Gallery uses only its embedded images. Optional SD-card
	  support adds the automounter applet and the required MMC/FAT kernel
	  configuration to the same image.

	  Selecting Gallery disables the standalone Display example. The
	  standalone SD-card package may coexist while Gallery's built-in SD
	  support is disabled. Enabling built-in support disables the standalone
	  package so that the sdcard command has exactly one owner.

comment "Gallery is disabled by Screen"
	depends on BR2_PACKAGE_FIRMWARE_SCREEN

if BR2_PACKAGE_GALLERY

menu "Gallery options"

config BR2_PACKAGE_GALLERY_COMPRESS_INITRAMFS
	bool "Compress the initramfs with gzip (NEW)"
	default y
	help
	  Store the embedded root filesystem as a gzip-compressed archive in
	  internal flash. Linux expands it into RAM during boot; the kernel
	  remains an XIP image and continues executing directly from flash.

config BR2_PACKAGE_GALLERY_AUTOSTART
	bool "Start the gallery automatically at boot"
	default y
	help
	  Install the package-owned /etc/init.d/S30gallery service and start the
	  non-interactive slideshow at boot.

config BR2_PACKAGE_GALLERY_SDCARD
	bool "Build SD-card support into the Gallery executable"
	help
	  Link the sdcard applet into Gallery and add MMC-over-SPI/FAT support
	  and the automount service.
	  This disables the standalone SD-card package because both packages
	  would otherwise install /usr/sbin/sdcard.

	  This option is disabled by default so the basic Gallery example has
	  no SD-card runtime or storage-stack dependency.

if BR2_PACKAGE_GALLERY_SDCARD

config BR2_PACKAGE_GALLERY_SDCARD_IMAGES
	bool "Use images from an automatically mounted SD card"
	help
	  Prefer supported images in the root of /mnt/sdcard when it is mounted
	  and contains images. Fall back to the embedded images otherwise.

	  Leave this disabled to demonstrate the built-in SD-card applet while
	  keeping the slideshow source fixed at /usr/share/display.

endif

endmenu

endif
