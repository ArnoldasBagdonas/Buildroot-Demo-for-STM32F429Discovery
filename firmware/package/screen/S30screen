#!/bin/sh

DAEMON=/usr/bin/screen-auto
PIDFILE=/run/screen.pid

is_running()
{
	start-stop-daemon -K -t -q -p "$PIDFILE"
}

start()
{
	printf 'Starting screen: '
	if is_running; then
		echo 'already running'
		return 0
	fi
	rm -f "$PIDFILE"
	if start-stop-daemon -S -q -b -m -p "$PIDFILE" -x "$DAEMON" -- run; then
		echo 'OK'
	else
		echo 'FAIL'
		return 1
	fi
}

stop()
{
	printf 'Stopping screen: '
	if ! is_running; then
		rm -f "$PIDFILE"
		echo 'not running'
		return 0
	fi
	start-stop-daemon -K -q -p "$PIDFILE"
	rm -f "$PIDFILE"
	echo 'OK'
}

status()
{
	if is_running; then
		echo "screen: running (PID $(cat "$PIDFILE"))"
		return 0
	fi
	echo 'screen: stopped'
	return 1
}

case "${1:-}" in
	start) start ;;
	stop) stop ;;
	restart) stop; start ;;
	status) status ;;
	*) echo "Usage: $0 {start|stop|restart|status}" >&2; exit 2 ;;
esac
