#!/bin/sh

set -u

if [ -r /etc/find-my-device.conf ]; then
	. /etc/find-my-device.conf
fi

FMD_INTERFACE=${FMD_INTERFACE:-eth0}
FMD_HTTP_PORT=${FMD_HTTP_PORT:-8080}
FMD_DEVICE_NAME=${FMD_DEVICE_NAME:-My Finder}
FMD_DEVICE_MODEL=${FMD_DEVICE_MODEL:-FINDER-R01}
FMD_STATE_FILE=${FMD_STATE_FILE:-/var/lib/find-my-device/state}
FMD_BUTTON_CHIP=${FMD_BUTTON_CHIP:-/dev/gpiochip2}
FMD_BUTTON_LINE=${FMD_BUTTON_LINE:-13}
FMD_LED_CHIP=${FMD_LED_CHIP:-/dev/gpiochip6}
FMD_LED_LINE=${FMD_LED_LINE:-9}
FMD_GPIO_ENABLED=${FMD_GPIO_ENABLED:-yes}

mkdir -p /var/lib/find-my-device /var/run

# SPI Ethernet probes asynchronously. Give it a short bounded wait so a
# missing or miswired module never prevents the console shell from starting.
FMD_WAIT=0
while [ ! -d "/sys/class/net/${FMD_INTERFACE}" ] && [ "${FMD_WAIT}" -lt 10 ]; do
	sleep 1
	FMD_WAIT=$((FMD_WAIT + 1))
done
if [ ! -d "/sys/class/net/${FMD_INTERFACE}" ]; then
	echo "find-my-device: ${FMD_INTERFACE} was not created; check W5500 wiring and the boot log" >&2
	exit 1
fi

FMD_MAC_RESULT=$(/usr/bin/find-my-device \
	--interface "${FMD_INTERFACE}" --prepare-interface 2>&1)
if [ "$?" -ne 0 ]; then
	echo "find-my-device: ${FMD_MAC_RESULT}" >&2
	exit 1
fi
echo "${FMD_MAC_RESULT}"

ifconfig "${FMD_INTERFACE}" up
if ! udhcpc -i "${FMD_INTERFACE}" -s /usr/share/find-my-device/udhcpc.script \
	-n -q -t 4 -T 2; then
	# A deterministic RFC 3927 address keeps direct-cable and isolated-switch
	# testing useful when no DHCP server is present.
	FMD_MAC=${FMD_MAC_RESULT#*=}
	FMD_OLD_IFS=${IFS}
	IFS=:
	set -- ${FMD_MAC}
	IFS=${FMD_OLD_IFS}
	FMD_LL3=$((0x$5))
	FMD_LL4=$((0x$6))
	[ "${FMD_LL3}" -eq 0 ] && FMD_LL3=1
	[ "${FMD_LL3}" -eq 255 ] && FMD_LL3=254
	[ "${FMD_LL4}" -eq 0 ] && FMD_LL4=1
	[ "${FMD_LL4}" -eq 255 ] && FMD_LL4=254
	FMD_ADDRESS="169.254.${FMD_LL3}.${FMD_LL4}"
	ifconfig "${FMD_INTERFACE}" "${FMD_ADDRESS}" netmask 255.255.0.0 up
	echo "find_my_device_ipv4=${FMD_ADDRESS} source=link-local-fallback"
fi

FMD_GPIO_ARGS="--no-gpio"
if [ "${FMD_GPIO_ENABLED}" = yes ]; then
	FMD_GPIO_ARGS="--button-chip ${FMD_BUTTON_CHIP} --button-line ${FMD_BUTTON_LINE} --led-chip ${FMD_LED_CHIP} --led-line ${FMD_LED_LINE}"
fi

echo $$ > /var/run/find-my-device.pid
# FMD_GPIO_ARGS is intentionally word-split into daemon options.
# shellcheck disable=SC2086
exec /usr/bin/find-my-device \
	--interface "${FMD_INTERFACE}" \
	--port "${FMD_HTTP_PORT}" \
	--state "${FMD_STATE_FILE}" \
	--name "${FMD_DEVICE_NAME}" \
	--model "${FMD_DEVICE_MODEL}" \
	${FMD_GPIO_ARGS}
