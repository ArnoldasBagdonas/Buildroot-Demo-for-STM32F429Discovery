#!/bin/sh

set -e

if [ -r /etc/find-my-device.conf ]; then
	. /etc/find-my-device.conf
fi

FMD_INTERFACE=${FMD_INTERFACE:-eth0}
FMD_HTTP_PORT=${FMD_HTTP_PORT:-8080}
FMD_DEVICE_NAME=${FMD_DEVICE_NAME:-My Finder}
FMD_DEVICE_MODEL=${FMD_DEVICE_MODEL:-FINDER-R01}
FMD_STATE_FILE=${FMD_STATE_FILE:-auto}
FMD_SDCARD_STATE_FILE=${FMD_SDCARD_STATE_FILE:-/mnt/sdcard/find-my-device/state}
FMD_SDCARD_WAIT=${FMD_SDCARD_WAIT:-10}
FMD_SPINAND_STATE_FILE=${FMD_SPINAND_STATE_FILE:-/mnt/spinand/find-my-device/state}
FMD_SPINAND_WAIT=${FMD_SPINAND_WAIT:-10}
FMD_BUTTON_CHIP=${FMD_BUTTON_CHIP:-/dev/gpiochip0}
FMD_BUTTON_LINE=${FMD_BUTTON_LINE:-0}
FMD_BUTTON_ACTIVE_LOW=${FMD_BUTTON_ACTIVE_LOW:-no}
FMD_LED_CHIP=${FMD_LED_CHIP:-/dev/gpiochip6}
FMD_LED_LINE=${FMD_LED_LINE:-13}
FMD_GPIO_ENABLED=${FMD_GPIO_ENABLED:-yes}
FMD_DHCP_WAIT=${FMD_DHCP_WAIT:-30}

fmd_mountpoint_mounted()
{
	FMD_CHECK_MOUNT=$1
	while read -r FMD_MOUNT_SOURCE FMD_MOUNT_TARGET FMD_MOUNT_REST; do
		if [ "${FMD_MOUNT_TARGET}" = "${FMD_CHECK_MOUNT}" ]; then
			return 0
		fi
	done < /proc/mounts
	return 1
}

FMD_STATE_BACKEND=configured
if [ "${FMD_STATE_FILE}" = auto ]; then
	FMD_STATE_FILE=/var/lib/find-my-device/state
	FMD_STATE_BACKEND=ram
	if [ -x /usr/sbin/sdcard ]; then
		# This also supports starting Find My Device manually before the boot
		# watcher has completed its first mount attempt.
		/usr/sbin/sdcard mount >/dev/null 2>&1 || true
		FMD_WAIT=0
		set +e
		while ! fmd_mountpoint_mounted /mnt/sdcard &&
			[ "${FMD_WAIT}" -lt "${FMD_SDCARD_WAIT}" ]; do
			sleep 1
			FMD_WAIT=$((FMD_WAIT + 1))
		done
		set -e
		if fmd_mountpoint_mounted /mnt/sdcard; then
			FMD_STATE_FILE=${FMD_SDCARD_STATE_FILE}
			FMD_STATE_BACKEND=sdcard
		fi
	fi
	if [ "${FMD_STATE_BACKEND}" = ram ] && [ -x /usr/sbin/spinand-ubi ]; then
		# The package's boot helper normally attaches UBI in the background.
		# If automount was disabled, explicitly try the same non-destructive mount.
		if [ ! -x /usr/sbin/spinand-ubi-auto ]; then
			/usr/sbin/spinand-ubi mount >/dev/null 2>&1 || true
		fi
		FMD_WAIT=0
		set +e
		while ! fmd_mountpoint_mounted /mnt/spinand &&
			[ "${FMD_WAIT}" -lt "${FMD_SPINAND_WAIT}" ]; do
			if [ -r /var/run/spinand-ubi.status ]; then
				read -r FMD_SPINAND_STATUS < /var/run/spinand-ubi.status
				case "${FMD_SPINAND_STATUS}" in
					missing|unavailable) break ;;
				esac
			fi
			sleep 1
			FMD_WAIT=$((FMD_WAIT + 1))
		done
		set -e
		if fmd_mountpoint_mounted /mnt/spinand; then
			FMD_STATE_FILE=${FMD_SPINAND_STATE_FILE}
			FMD_STATE_BACKEND=spinand
		fi
	fi
	if [ "${FMD_STATE_BACKEND}" = ram ]; then
		echo "find-my-device: no persistent storage is mounted; state is temporary" >&2
	fi
fi

FMD_STATE_DIRECTORY=${FMD_STATE_FILE%/*}
if [ -z "${FMD_STATE_DIRECTORY}" ] || [ "${FMD_STATE_DIRECTORY}" = "${FMD_STATE_FILE}" ]; then
	echo "find-my-device: state path must include a directory: ${FMD_STATE_FILE}" >&2
	exit 1
fi
mkdir -p "${FMD_STATE_DIRECTORY}" /var/run
echo "find_my_device_state=${FMD_STATE_FILE} backend=${FMD_STATE_BACKEND}"

# SPI Ethernet probes asynchronously. Give it a short bounded wait so a
# missing or miswired module never prevents the console shell from starting.
FMD_WAIT=0
# BusyBox hush incorrectly applies `set -e` to the final false condition of
# these bounded waits, so disable it only while waiting.
set +e
while [ ! -d "/sys/class/net/${FMD_INTERFACE}" ] && [ "${FMD_WAIT}" -lt 10 ]; do
	sleep 1
	FMD_WAIT=$((FMD_WAIT + 1))
done
set -e
if [ ! -d "/sys/class/net/${FMD_INTERFACE}" ]; then
	echo "find-my-device: ${FMD_INTERFACE} was not created; check W5500 wiring and the boot log" >&2
	exit 1
fi

if ! FMD_MAC_RESULT=$(/usr/bin/find-my-device \
	--interface "${FMD_INTERFACE}" --prepare-interface 2>&1); then
	echo "find-my-device: ${FMD_MAC_RESULT}" >&2
	exit 1
fi
echo "${FMD_MAC_RESULT}"

ifconfig "${FMD_INTERFACE}" up

FMD_MAC=${FMD_MAC_RESULT#*=}
# Use an opaque, deterministic client identifier distinct from BusyBox's
# default type-1 MAC identifier. This survives reboot while avoiding stale
# leases left by older images which used the default identifier.
FMD_DHCP_CLIENT_ID="00${FMD_MAC//:/}"
: > /var/run/find-my-device.ipv4
# Keep udhcpc alive so it renews leases and retries after a late cable insert.
# -f prevents its no-MMU daemon re-exec; the shell backgrounds it explicitly.
udhcpc -f -i "${FMD_INTERFACE}" -s /usr/share/find-my-device/udhcpc.script \
	-x "0x3d:${FMD_DHCP_CLIENT_ID}" -t 4 -T 2 -A 5 &
echo $! > /var/run/find-my-device.udhcpc.pid

FMD_WAIT=0
set +e
while [ ! -s /var/run/find-my-device.ipv4 ] && [ "${FMD_WAIT}" -lt "${FMD_DHCP_WAIT}" ]; do
	sleep 1
	FMD_WAIT=$((FMD_WAIT + 1))
done
set -e
if [ ! -s /var/run/find-my-device.ipv4 ]; then
	# A deterministic RFC 3927 address keeps direct-cable and isolated-switch
	# testing useful while the persistent DHCP client continues retrying.
	FMD_OLD_IFS=${IFS}
	IFS=:
	set -- ${FMD_MAC}
	IFS=${FMD_OLD_IFS}
	FMD_LL3=$((0x$5))
	FMD_LL4=$((0x$6))
	[ "${FMD_LL3}" -eq 0 ] && FMD_LL3=1
	[ "${FMD_LL3}" -eq 255 ] && FMD_LL3=254
	[ "${FMD_LL4}" -eq 0 ] && FMD_LL4=1
	[ "${FMD_LL4}" -eq 255 ] && FMD_LL4=254
	FMD_ADDRESS="169.254.${FMD_LL3}.${FMD_LL4}"
	ifconfig "${FMD_INTERFACE}" "${FMD_ADDRESS}" netmask 255.255.0.0 up
	echo "find_my_device_ipv4=${FMD_ADDRESS} source=link-local-fallback"
fi

FMD_GPIO_ARGS="--no-gpio"
if [ "${FMD_GPIO_ENABLED}" = yes ]; then
	FMD_GPIO_ARGS="--button-chip ${FMD_BUTTON_CHIP} --button-line ${FMD_BUTTON_LINE} --led-chip ${FMD_LED_CHIP} --led-line ${FMD_LED_LINE}"
	if [ "${FMD_BUTTON_ACTIVE_LOW}" = yes ]; then
		FMD_GPIO_ARGS="${FMD_GPIO_ARGS} --button-active-low"
	fi
fi

echo $$ > /var/run/find-my-device.pid
# FMD_GPIO_ARGS is intentionally word-split into daemon options.
# shellcheck disable=SC2086
exec /usr/bin/find-my-device \
	--interface "${FMD_INTERFACE}" \
	--port "${FMD_HTTP_PORT}" \
	--state "${FMD_STATE_FILE}" \
	--name "${FMD_DEVICE_NAME}" \
	--model "${FMD_DEVICE_MODEL}" \
	${FMD_GPIO_ARGS}
